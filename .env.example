# Copy to .env in the repository root for local backend development.
# Keep real credentials in your deployment's secret store, never in Git or VITE_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Local Vite origin; production must set its exact HTTPS frontend origin.
CLIENT_URL=http://localhost:3000
PORT=5000
